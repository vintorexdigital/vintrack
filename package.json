{
  "name": "trackrex",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @trackrex/api db:migrate",
    "db:seed": "pnpm --filter @trackrex/api db:seed"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ch52-4w7c-c8xp"
      ]
    },
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "sharp",
      "better-sqlite3",
      "electron",
      "@nestjs/core",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss": ">=8.5.23",
      "tar": ">=7.5.21",
      "exceljs>uuid": "^11.1.1"
    }
  }
}
