{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@trackrex/client-core": [
        "../../packages/client-core/src/index.ts"
      ],
      "@trackrex/forms": [
        "../../packages/rules/src/forms.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../packages/client-core/src/**/*.ts",
    "../../packages/rules/src/forms.ts"
  ],
  "exclude": [
    "../../packages/client-core/src/**/*.spec.ts",
    "../../packages/client-core/src/test-utils.ts",
    "node_modules"
  ]
}
