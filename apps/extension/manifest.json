{
  "manifest_version": 3,
  "name": "Trackrex activity",
  "version": "0.1.0",
  "description": "Records which websites you work in, only while you are punched in, if your company has turned it on.",
  "permissions": ["tabs", "idle", "alarms", "storage"],
  "host_permissions": ["http://localhost:4000/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Trackrex activity", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
