# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PRIMARY_DOMAIN=trackrex.test
WEB_ORIGIN=http://localhost:3000
PLATFORM_ORIGIN=http://localhost:3001

# PostgreSQL: owner (migrations only) and the three runtime roles created by migration 0001.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/trackrex
DATABASE_APP_URL=postgres://trackrex_app:CHANGE_ME@127.0.0.1:5432/trackrex
DATABASE_PLATFORM_URL=postgres://trackrex_platform:CHANGE_ME@127.0.0.1:5432/trackrex
DATABASE_WORKER_URL=postgres://trackrex_worker:CHANGE_ME@127.0.0.1:5432/trackrex
REDIS_URL=redis://127.0.0.1:6379

# Generate with: openssl rand -base64 48
JWT_COMPANY_SECRET=
JWT_PLATFORM_SECRET=

# Development only: echo OTP codes and invitation tokens in API responses.
AUTH_DEV_OTP_ECHO=false
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_API_URL=http://localhost:4000

# Billing: manual (bank transfer, finance records payments), razorpay or stripe.
BILLING_PROVIDER=manual
BILLING_SELLER_NAME=Vintorex
BILLING_SELLER_GSTIN=
BILLING_SELLER_ADDRESS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Uploaded files (selfies) on local disk. Must be a persistent volume in production.
FILES_DIR=./var/files
# STORAGE_DRIVER=disk keeps files on this host. Use s3 (any S3-compatible store) to run the API on several hosts.
STORAGE_DRIVER=disk
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# S3_REGION=ap-south-1
# S3_BUCKET=trackrex-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PATH_STYLE=true

# Extra browser origins for CORS, comma separated (for example the mobile app's web build in development).
CORS_EXTRA_ORIGINS=

# Compose deployment
POSTGRES_PASSWORD=
SUPPORT_EMAIL=
CONTACT_EMAIL=
MAP_TILES_URL=

# Outbound email (SMTP). Without it, messages are only logged.
SMTP_URL=
MAIL_FROM=Trackrex <no-reply@example.com>

# Envelope encryption of location data and selfies. KMS_MASTER_KEYS is id:base64(32 bytes), comma separated, first is current.
# The built-in development key is public: generate your own with `openssl rand -base64 32`. Required in production.
ENVELOPE_ENCRYPTION=true
# KMS_MASTER_KEYS=prod-1:<base64>

# Delivery channels. 'mock' (the default) delivers nothing: messages are only recorded in the company's message log.
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
PUSH_PROVIDER=mock
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=+1555...
# TWILIO_WHATSAPP_FROM=+1555...
# EXPO_ACCESS_TOKEN=

# Cloud calling. 'mock' places no call and records synthetic audio. PUBLIC_API_URL is where the provider calls back.
TELEPHONY_PROVIDER=mock
# EXOTEL_SID=
# EXOTEL_API_KEY=
# EXOTEL_API_TOKEN=
# EXOTEL_SUBDOMAIN=api.exotel.com
# EXOTEL_CALLER_ID=
# TELEPHONY_WEBHOOK_TOKEN=<long random string>
PUBLIC_API_URL=http://localhost:4000

# Workflow webhooks may only call public https addresses. Never enable this in production.
WORKFLOW_WEBHOOK_ALLOW_PRIVATE=false
