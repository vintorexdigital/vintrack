# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PRIMARY_DOMAIN=trackrex.test
WEB_ORIGIN=http://localhost:3000
PLATFORM_ORIGIN=http://localhost:3001

# PostgreSQL: owner (migrations only) and the three runtime roles created by migration 0001.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/trackrex
DATABASE_APP_URL=postgres://trackrex_app:CHANGE_ME@127.0.0.1:5432/trackrex
DATABASE_PLATFORM_URL=postgres://trackrex_platform:CHANGE_ME@127.0.0.1:5432/trackrex
DATABASE_WORKER_URL=postgres://trackrex_worker:CHANGE_ME@127.0.0.1:5432/trackrex
REDIS_URL=redis://127.0.0.1:6379

# Generate with: openssl rand -base64 48
JWT_COMPANY_SECRET=
JWT_PLATFORM_SECRET=

# Development only: echo OTP codes and invitation tokens in API responses.
AUTH_DEV_OTP_ECHO=false
GOOGLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_API_URL=http://localhost:4000
