# Next.js apps (web, platform). NEXT_PUBLIC_* values are compiled into the client bundle, so they are build arguments.
FROM node:22-slim AS build
ARG APP=web
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_MAP_TILES
RUN corepack enable
WORKDIR /repo
COPY . .
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_PUBLIC_MAP_TILES=$NEXT_PUBLIC_MAP_TILES
RUN pnpm install --frozen-lockfile && pnpm --filter @trackrex/$APP build

FROM node:22-slim
ARG APP=web
WORKDIR /repo
ENV NODE_ENV=production APP=$APP
RUN corepack enable
COPY --from=build /repo /repo
USER node
CMD ["sh", "-c", "pnpm --filter @trackrex/$APP start"]
