FROM node:22-slim AS build
ARG APP=web
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @trackrex/$APP build

FROM node:22-slim
ARG APP=web
WORKDIR /repo
ENV NODE_ENV=production APP=$APP
COPY --from=build /repo /repo
USER node
CMD ["sh", "-c", "pnpm --filter @trackrex/$APP start"]
