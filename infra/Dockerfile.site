# The marketing site is a static export served by Caddy: nothing to run, patch or scale.
FROM node:22-slim AS build
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_CONTACT_EMAIL
RUN corepack enable
WORKDIR /repo
COPY . .
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL NEXT_PUBLIC_CONTACT_EMAIL=$NEXT_PUBLIC_CONTACT_EMAIL
RUN pnpm install --frozen-lockfile && pnpm --filter @trackrex/site build

FROM caddy:2
COPY --from=build /repo/apps/site/out /srv
COPY infra/Caddyfile.site /etc/caddy/Caddyfile
